export const useTranslation = () => {
  const language = useThemeStore((state) => state.language) || 'en';
  const setLanguage = useThemeStore((state) => state.setLanguage);

  const t: Translations = translations[language] || translations.en;

  return {
    t,
    language,
    setLanguage,
  };
};

